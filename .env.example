# Supabase project configuration. The anon key is browser-safe by provider design,
# but authenticated operations use server routes and session cookies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application origin used for invitation/reset callback URLs in production.
APP_BASE_URL=

# AI processing fails closed in both API and worker unless explicitly enabled.
AI_ENABLED=false

# DeepSeek is called only from the server-side worker.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional embedding provider; semantic retrieval stays unavailable until implemented/configured.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# WhatsApp Business Cloud API (reserved; dispatcher/webhook integration is not implemented).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Worker connection/queue configuration; use dedicated Supabase credentials.
DATABASE_URL=
JOB_QUEUE_URL=

# Supabase private storage bucket used for research documents.
SUPABASE_STORAGE_BUCKET=forevit-private
